import { LineEdit, ListView, Palette } from "std-widgets.slint";
export { SettingsWindow } from "settings.slint";

export struct ClipRow {
    text: string,
    meta: string,
    // text, link, code, image, color, email, phone, doc (CPF/CNPJ), path, json.
    kind: string,
    thumb: image,
    // Cor do item, quando o texto é um código de cor (#2E63FF, rgb(…)).
    swatch: color,
    pinned: bool,
    // Nome dado a um fixado; vazio nos demais.
    name: string,
}

// Alfinete. O glifo cheio da fonte (E841) é só a cabeça, sem a agulha; o contorno (E718)
// por cima devolve a ponta e deixa o fixado com o mesmo desenho do solto.
component PinGlyph {
    in property <bool> filled;
    in property <length> font-size: 14px;
    in property <color> color;

    if root.filled: Text {
        width: parent.width;
        height: parent.height;
        font-family: "Segoe Fluent Icons";
        font-size: root.font-size;
        color: root.color;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: "\u{E841}";
    }
    Text {
        width: parent.width;
        height: parent.height;
        font-family: "Segoe Fluent Icons";
        font-size: root.font-size;
        color: root.color;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: "\u{E718}";
    }
}

component KindIcon inherits Text {
    in property <string> kind;
    width: 16px;
    font-family: "Segoe Fluent Icons";
    font-size: 14px;
    horizontal-alignment: center;
    vertical-alignment: center;
    text: kind == "link" ? "\u{E71B}"
        : kind == "code" || kind == "json" ? "\u{E943}"
        : kind == "image" ? "\u{E91B}"
        : kind == "email" ? "\u{E715}"
        : kind == "phone" ? "\u{E717}"
        : kind == "doc" ? "\u{E8A5}"
        : kind == "path" ? "\u{E8B7}"
        : "\u{E8C8}";
}

export component AppWindow inherits Window {
    title: "Landpad";
    no-frame: true;
    always-on-top: true;
    width: 400px;
    height: 440px;
    background: Palette.background;
    default-font-family: "Segoe UI Variable Text";
    default-font-size: 13px;

    in property <[ClipRow]> rows;
    in property <string> footer;
    // Prévia da imagem selecionada; vazia quando o item é texto.
    in property <image> preview;
    // Prévia de texto longo ou com várias linhas; vazia quando não há o que mostrar.
    in property <string> preview-text;
    in property <bool> preview-mono;
    in property <image> logo;
    // O Rust resolve "seguir o Windows" para claro ou escuro.
    in property <bool> dark-mode;
    in-out property <int> selected: 0;
    // Shift+setas estende a seleção a partir daqui; -1 quando só uma linha está selecionada.
    in-out property <int> anchor: -1;
    property <int> sel-lo: root.anchor < 0 ? root.selected : min(root.anchor, root.selected);
    property <int> sel-hi: root.anchor < 0 ? root.selected : max(root.anchor, root.selected);
    in-out property <bool> only-pinned: false;
    // Mostra o número das 9 primeiras linhas só quando Ctrl+Shift+número está ligado.
    in property <bool> quick-paste: true;

    callback query-edited(string);
    // O segundo argumento é Shift: com ele, só copia; sem ele, cola no app de origem.
    callback activate(int, bool);
    callback toggle-pin(int);
    callback remove(int);
    // Ctrl+Enter ou menu: abre o link no navegador (em outros itens, cola).
    callback open-link(int);
    // Menu "Colar como": cola o texto transformado ("upper", "lower", "oneline", "trim",
    // "digits", "json-pretty", "json-min").
    callback paste-as(int, string);
    // Enter com várias linhas selecionadas: cola (ou copia) os textos juntos.
    callback activate-range(int, int, bool);
    // Nome novo de um fixado; vazio tira o nome.
    callback rename(int, string);
    // Menu de uma imagem: grava um PNG em Imagens\Landpad.
    callback save-image(int);
    callback pinned-filter(bool);
    callback selection-changed();
    callback open-settings();
    callback dismiss();
    callback quit();

    changed selected => {
        root.selection-changed();
    }
    init => {
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark-mode => {
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }

    property <length> row-h: 30px;
    property <length> card-h: 164px;
    property <bool> has-preview: root.preview.width > 0 || root.preview-text != "";
    // Topo da linha selecionada dentro da área visível da lista.
    property <length> selected-top: root.selected * root.row-h + list.content-y;
    property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    property <color> accent: dark ? #8ca9ff : #2e63ff;
    property <color> link-color: dark ? #5fd4bf : #0f7b6c;
    property <color> muted: dark ? #c5c5c5 : #5c5c5c;
    property <color> selected-bg: dark ? #ffffff14 : #0f172a10;
    property <color> hover-bg: dark ? #ffffff0c : #0f172a0a;
    property <color> card-bg: dark ? #2b2b2b : #ffffff;
    property <color> thumb-border: dark ? #ffffff24 : #0f172a1f;

    public function open() {
        search.text = "";
        root.only-pinned = false;
        root.selected = 0;
        root.anchor = -1;
        list.content-y = 0;
        search.focus();
    }

    // Caixinha para dar nome a um fixado (F2 ou menu). O conteúdo do PopupWindow só existe
    // enquanto ele está aberto, então o nome atual chega por esta propriedade.
    property <int> rename-index: -1;
    property <string> rename-current;
    function start-rename(index: int, current: string) {
        root.rename-index = index;
        root.rename-current = current;
        rename-popup.show();
    }

    // Seleciona e rola até a linha, como as setas fazem.
    public function select(index: int) {
        root.move(index - root.selected);
    }

    function toggle-filter() {
        root.only-pinned = !root.only-pinned;
        root.selected = 0;
        root.anchor = -1;
        list.content-y = 0;
        root.pinned-filter(root.only-pinned);
    }

    // Com `extend`, a linha de partida vira âncora e a seleção cresce até a nova linha.
    function move-by(delta: int, extend: bool) {
        if (extend) {
            if (root.anchor < 0) {
                root.anchor = root.selected;
            }
        } else {
            root.anchor = -1;
        }
        root.move(delta);
    }

    function move(delta: int) {
        if (root.rows.length == 0) {
            return;
        }
        root.selected = max(0, min(root.rows.length - 1, root.selected + delta));
        if (root.selected * root.row-h < -list.content-y) {
            list.content-y = -root.selected * root.row-h;
        } else if ((root.selected + 1) * root.row-h > list.visible-height - list.content-y) {
            list.content-y = list.visible-height - (root.selected + 1) * root.row-h;
        }
    }

    forward-focus: search;

    FocusScope {
        capture-key-pressed(event) => {
            if (event.text == Key.UpArrow) {
                root.move-by(-1, event.modifiers.shift);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.move-by(1, event.modifiers.shift);
                return accept;
            }
            if (event.text == Key.PageUp) {
                root.move-by(-10, event.modifiers.shift);
                return accept;
            }
            if (event.text == Key.PageDown) {
                root.move-by(10, event.modifiers.shift);
                return accept;
            }
            if (event.text == Key.Return) {
                if (root.anchor >= 0 && root.anchor != root.selected) {
                    root.activate-range(root.sel-lo, root.sel-hi, event.modifiers.shift);
                } else if (event.modifiers.control) {
                    root.open-link(root.selected);
                } else {
                    root.activate(root.selected, event.modifiers.shift);
                }
                return accept;
            }
            if (event.text == Key.F2) {
                if (root.selected < root.rows.length && root.rows[root.selected].pinned) {
                    root.start-rename(root.selected, root.rows[root.selected].name);
                }
                return accept;
            }
            if (event.text == Key.Escape) {
                if (root.anchor >= 0) {
                    root.anchor = -1;
                } else if (search.text != "") {
                    search.text = "";
                    root.selected = 0;
                    root.query-edited("");
                } else {
                    root.dismiss();
                }
                return accept;
            }
            if (event.text == Key.Tab || event.text == Key.Backtab) {
                root.toggle-filter();
                return accept;
            }
            if (event.text == Key.Delete) {
                if (root.selected < root.rows.length) {
                    root.remove(root.selected);
                }
                return accept;
            }
            if (event.modifiers.control && (event.text == "p" || event.text == "P")) {
                if (root.selected < root.rows.length) {
                    root.toggle-pin(root.selected);
                }
                return accept;
            }
            if (event.modifiers.control && event.text == ",") {
                root.open-settings();
                return accept;
            }
            if (event.modifiers.control && (event.text == "q" || event.text == "Q")) {
                root.quit();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            HorizontalLayout {
                padding: 8px;
                padding-left: 10px;
                spacing: 8px;

                VerticalLayout {
                    alignment: center;
                    Image {
                        width: 24px;
                        height: 24px;
                        source: root.logo;
                    }
                }

                search := LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: root.only-pinned ? "Buscar nos fixados" : "Buscar no histórico";
                    edited(text) => {
                        root.selected = 0;
                        root.query-edited(text);
                    }
                }

                // Filtro de fixados: liga e desliga com clique ou Tab.
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 30px;
                        height: 30px;
                        border-radius: 4px;
                        background: root.only-pinned ? root.selected-bg : (filter-touch.has-hover ? root.hover-bg : transparent);

                        PinGlyph {
                            width: parent.width;
                            height: parent.height;
                            filled: root.only-pinned;
                            font-size: 14px;
                            color: root.only-pinned ? root.accent : root.muted;
                        }

                        filter-touch := TouchArea {
                            clicked => {
                                root.toggle-filter();
                            }
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 30px;
                        height: 30px;
                        border-radius: 4px;
                        background: gear-touch.has-hover ? root.hover-bg : transparent;

                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: "\u{E713}";
                            font-family: "Segoe Fluent Icons";
                            font-size: 14px;
                            color: root.muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        gear-touch := TouchArea {
                            clicked => {
                                root.open-settings();
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Palette.border;
            }

            Rectangle {
                vertical-stretch: 1;

                list := ListView {
                    width: parent.width;
                    height: parent.height;

                    for row[i] in root.rows: Rectangle {
                        height: root.row-h;

                        // Botão direito: as mesmas ações das teclas, para quem não as conhece.
                        menu := ContextMenuArea {
                            x: 4px;
                            y: 1px;
                            width: parent.width - 8px;
                            height: parent.height - 2px;

                            Menu {
                                MenuItem {
                                    title: "Colar (Enter)";
                                    activated => {
                                        root.activate(i, false);
                                    }
                                }
                                MenuItem {
                                    title: "Copiar sem colar (Shift+Enter)";
                                    activated => {
                                        root.activate(i, true);
                                    }
                                }
                                if row.kind == "link" || row.kind == "email" || row.kind == "path": MenuItem {
                                    title: row.kind == "link" ? "Abrir no navegador (Ctrl+Enter)"
                                        : row.kind == "email" ? "Escrever e-mail (Ctrl+Enter)"
                                        : "Abrir no Explorer (Ctrl+Enter)";
                                    activated => {
                                        root.open-link(i);
                                    }
                                }
                                if row.kind == "doc" || row.kind == "phone": MenuItem {
                                    title: "Colar só os números";
                                    activated => {
                                        root.paste-as(i, "digits");
                                    }
                                }
                                if row.kind == "json": MenuItem {
                                    title: "Colar formatado";
                                    activated => {
                                        root.paste-as(i, "json-pretty");
                                    }
                                }
                                if row.kind == "json": MenuItem {
                                    title: "Colar compacto";
                                    activated => {
                                        root.paste-as(i, "json-min");
                                    }
                                }
                                if row.kind == "image": MenuItem {
                                    title: "Salvar em Imagens\\Landpad";
                                    activated => {
                                        root.save-image(i);
                                    }
                                }
                                if row.kind != "image": Menu {
                                    title: "Colar como";
                                    MenuItem {
                                        title: "MAIÚSCULAS";
                                        activated => {
                                            root.paste-as(i, "upper");
                                        }
                                    }
                                    MenuItem {
                                        title: "minúsculas";
                                        activated => {
                                            root.paste-as(i, "lower");
                                        }
                                    }
                                    MenuItem {
                                        title: "Uma linha só";
                                        activated => {
                                            root.paste-as(i, "oneline");
                                        }
                                    }
                                    MenuItem {
                                        title: "Sem espaços extras";
                                        activated => {
                                            root.paste-as(i, "trim");
                                        }
                                    }
                                }
                                MenuSeparator { }
                                MenuItem {
                                    title: row.pinned ? "Soltar (Ctrl+P)" : "Fixar no topo (Ctrl+P)";
                                    activated => {
                                        root.toggle-pin(i);
                                    }
                                }
                                if row.pinned: MenuItem {
                                    title: row.name == "" ? "Dar um nome… (F2)" : "Renomear… (F2)";
                                    activated => {
                                        root.start-rename(i, row.name);
                                    }
                                }
                                MenuItem {
                                    title: "Apagar (Delete)";
                                    activated => {
                                        root.remove(i);
                                    }
                                }
                            }

                        Rectangle {
                            border-radius: 4px;
                            background: i >= root.sel-lo && i <= root.sel-hi ? root.selected-bg : (touch.has-hover || pin-touch.has-hover ? root.hover-bg : transparent);

                            Rectangle {
                                x: 0px;
                                y: (parent.height - 16px) / 2;
                                width: 3px;
                                height: 16px;
                                border-radius: 1.5px;
                                background: root.accent;
                                visible: i == root.selected;
                            }

                            HorizontalLayout {
                                padding-left: 10px;
                                // Espaço do alfinete, que fica por cima para receber o clique.
                                padding-right: 30px;
                                spacing: 8px;

                                if root.quick-paste: Text {
                                    width: 12px;
                                    text: i < 9 ? "\{i + 1}" : "";
                                    font-size: 11px;
                                    color: root.muted;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                if row.kind == "color": Rectangle {
                                    width: 16px;
                                    Rectangle {
                                        x: 1px;
                                        y: (parent.height - 14px) / 2;
                                        width: 14px;
                                        height: 14px;
                                        border-radius: 7px;
                                        background: row.swatch;
                                        border-width: 1px;
                                        border-color: root.thumb-border;
                                    }
                                }

                                if row.kind != "color": KindIcon {
                                    kind: row.kind;
                                    color: row.kind == "link" || row.kind == "image" ? root.link-color : row.kind == "code" ? root.muted : root.accent;
                                }

                                if row.kind == "image": VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 36px;
                                        height: 22px;
                                        Image {
                                            width: parent.width;
                                            height: parent.height;
                                            source: row.thumb;
                                            image-fit: fill;
                                        }
                                        Rectangle {
                                            border-width: 1px;
                                            border-radius: 2px;
                                            border-color: root.thumb-border;
                                        }
                                    }
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: row.text;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    color: Palette.foreground;
                                    // Um fixado com nome mostra o nome, em peso maior; o conteúdo fica na prévia.
                                    font-family: row.name == "" && (row.kind == "code" || row.kind == "json") ? "Cascadia Mono" : "Segoe UI Variable Text";
                                    font-size: row.name == "" && (row.kind == "code" || row.kind == "json") ? 12px : 13px;
                                    font-weight: row.name != "" ? 600 : 400;
                                }

                                Text {
                                    text: row.meta;
                                    font-size: 11px;
                                    color: root.muted;
                                    vertical-alignment: center;
                                }
                            }

                            // Clique cola o item, como o Enter; com Shift, só copia. Botão direito
                            // seleciona e abre o menu (a TouchArea fica com o evento, então o
                            // menu é aberto daqui).
                            touch := TouchArea {
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                                        root.anchor = -1;
                                        root.selected = i;
                                        root.activate(i, event.modifiers.shift);
                                    }
                                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                        root.anchor = -1;
                                        root.selected = i;
                                        menu.show({ x: self.mouse-x, y: self.mouse-y });
                                    }
                                }
                            }

                            // Alfinete: sempre visível nos fixados; nos outros, só com o mouse em cima ou selecionado.
                            Rectangle {
                                x: parent.width - 28px;
                                width: 24px;
                                height: parent.height;
                                property <bool> lit: row.pinned || touch.has-hover || pin-touch.has-hover || i == root.selected;

                                PinGlyph {
                                    width: parent.width;
                                    height: parent.height;
                                    filled: row.pinned;
                                    font-size: 13px;
                                    color: !parent.lit ? transparent : row.pinned ? root.accent : pin-touch.has-hover ? Palette.foreground : root.muted;
                                }

                                pin-touch := TouchArea {
                                    clicked => {
                                        root.toggle-pin(i);
                                    }
                                }
                            }
                        }
                        }
                    }
                }

                if root.rows.length == 0: Text {
                    width: parent.width;
                    height: parent.height;
                    text: search.text != "" ? "Nada encontrado." : root.only-pinned ? "Nenhum item fixado. Ctrl+P fixa o item selecionado." : "Nada por aqui ainda. Copie algo com Ctrl+C.";
                    color: root.muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                // Cartão de prévia: fica embaixo, ou em cima se a linha selecionada estiver lá embaixo.
                if root.has-preview: Rectangle {
                    x: 8px;
                    y: root.selected-top + root.row-h > parent.height - root.card-h - 8px ? 8px : parent.height - root.card-h - 8px;
                    width: parent.width - 16px;
                    height: root.card-h;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Palette.border;
                    background: root.card-bg;

                    if root.preview.width > 0: Image {
                        x: 6px;
                        y: 6px;
                        width: parent.width - 12px;
                        height: parent.height - 12px;
                        source: root.preview;
                        // A prévia já vem no tamanho certo; só não deixa ampliar imagens pequenas.
                        image-fit: preserve;
                    }
                    if root.preview-text != "": Text {
                        x: 12px;
                        y: 10px;
                        width: parent.width - 24px;
                        height: parent.height - 20px;
                        text: root.preview-text;
                        wrap: word-wrap;
                        overflow: elide;
                        vertical-alignment: top;
                        color: Palette.foreground;
                        font-family: root.preview-mono ? "Cascadia Mono" : "Segoe UI Variable Text";
                        font-size: 12px;
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Palette.border;
            }

            Rectangle {
                height: 28px;
                background: Palette.alternate-background;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;

                    Text {
                        horizontal-stretch: 1;
                        text: root.footer;
                        overflow: elide;
                        font-size: 11px;
                        color: root.muted;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-width: 1px;
        border-color: Palette.border;
    }

    rename-popup := PopupWindow {
        x: 8px;
        y: 48px;
        width: root.width - 16px;
        height: 40px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: root.card-bg;
            border-radius: 6px;
            border-width: 1px;
            border-color: Palette.border;
            HorizontalLayout {
                padding: 5px;
                padding-left: 10px;
                spacing: 8px;
                Text {
                    text: "Nome:";
                    vertical-alignment: center;
                    color: root.muted;
                }
                rename-edit := LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: "Como este fixado aparece na lista";
                    text: root.rename-current;
                    init => {
                        self.focus();
                        self.select-all();
                    }
                    accepted(text) => {
                        root.rename(root.rename-index, text);
                        rename-popup.close();
                    }
                }
            }
        }
    }
}
