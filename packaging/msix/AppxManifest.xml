<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifesto do pacote MSIX da Microsoft Store. build.ps1 preenche os campos {{...}} com a
  identidade que o Partner Center dá ao app e com a versão do Cargo.toml.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity Name="{{IDENTITY_NAME}}" Publisher="{{PUBLISHER}}" Version="{{VERSION}}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Landpad</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="pt-BR" />
  </Resources>

  <Applications>
    <Application Id="Landpad" Executable="Landpad.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Landpad"
        Description="Histórico da área de transferência e captura de tela"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Iniciar com o Windows na versão da loja: o usuário liga e desliga em
             Configurações > Aplicativos > Inicialização. -->
        <desktop:Extension Category="windows.startupTask" Executable="Landpad.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="LandpadStartup" Enabled="true" DisplayName="Landpad" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- App Win32 de desktop: escuta a área de transferência, registra atalhos globais,
         cola com Ctrl+V simulado e captura a tela. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
